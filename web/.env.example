# Public origin of the DarkPatternPrevent backend (Next API + scan worker), no trailing slash.
# Every /api/v1 request from this site is proxied there so the session cookie stays first-party.
BAROMI_API_ORIGIN=https://api.example.com

# true: run every screen against built-in sample data (no backend needed, e.g. Vercel previews).
NEXT_PUBLIC_DEMO_MODE=false
